{
    "name": "code-as-city",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "generate": "bun src/generate-map.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "knip": "knip",
        "test": "vitest run",
        "check": "bun run typecheck && bun run lint && bun run knip && bun run test",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "three": "^0.185.1",
        "troika-three-text": "0.52.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/node": "^26.3.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitest/coverage-v8": "^4.1.11",
        "knip": "^6.32.2",
        "typescript": "5.9.3",
        "vite": "8.2.1",
        "vitest": "^4.1.11"
    }
}
