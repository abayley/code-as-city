{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!vendor", "!out", "!baseline", "!test/fixtures", "!test/golden"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useComponentExportOnlyModules": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["viewer/components/ui/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "useSemanticElements": "off",
                        "useFocusableInteractive": "off",
                        "noLabelWithoutControl": "off",
                        "useKeyWithClickEvents": "off"
                    },
                    "correctness": {
                        "useExhaustiveDependencies": "off"
                    },
                    "style": {
                        "useComponentExportOnlyModules": "off"
                    },
                    "suspicious": {
                        "noDoubleEquals": "off",
                        "noArrayIndexKey": "off",
                        "noDocumentCookie": "off"
                    }
                }
            }
        },
        {
            "includes": ["test/**"],
            "linter": {
                "rules": {
                    "style": {
                        "useComponentExportOnlyModules": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
